# Copy to .env and fill in. Providers without a key are skipped automatically.

# Layer 1: GA4 AI traffic
GA_PROPERTY_ID=
GA_CREDENTIALS=data/service-account-key.json

# Layer 2: GEO monitor (chatbot APIs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Layer 3: Peec AI (Personal Access Token, works on the Peec MCP server only)
PEEC_PAT=

# Optional
PYTHON_EXE=
SHARE_DIR=
